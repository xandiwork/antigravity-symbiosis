# Configurações do Antigravity Symbiosis

# Caminho para o seu vault do Obsidian ou pasta onde os logs de auditoria serão salvos
# Exemplos:
# Windows: SYMBIOSIS_KNOWLEDGE_PATH="C:/Users/seu_usuario/Documents/ObsidianVault/knowledge"
# Linux/macOS: SYMBIOSIS_KNOWLEDGE_PATH="/home/usuario/knowledge"
# Relativo: SYMBIOSIS_KNOWLEDGE_PATH="./knowledge"
SYMBIOSIS_KNOWLEDGE_PATH="./knowledge"
